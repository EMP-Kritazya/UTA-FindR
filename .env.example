# Copy to .env and fill in. .env is git-ignored.

# --- Postgres (used by docker-compose.yml AND by the crawler) ---
POSTGRES_USER=utafindr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=utafindr
# Host port 5344, because a local Postgres may already be using 5432.
DATABASE_URL=postgresql+psycopg://utafindr:change-me@localhost:5344/utafindr

# --- Crawler ---
DATA_DIR=./data
# Shown in our User-Agent so UTA can contact us about the crawler.
CONTACT_EMAIL=you@example.com
REPO_URL=https://github.com/<you>/UTA-FindR
RATE_LIMIT_PER_SEC=1.0
SINCE_TERM=Spring 2023
